{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/site.json: lo general de la web",
  "description": "data/site.json: los textos, los colores, el about, el juego (dressme), las galerías y las animaciones, en orden. VS Code lee este fichero (por el \"$schema\" de arriba del JSON) para autocompletar, explicar cada campo y subrayar lo que está mal; el build y la vista previa lo usan para revisar.",
  "type": "object",
  "required": [
    "siteTitle",
    "seo",
    "lists"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_": {
      "type": "string"
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://[^/]+$",
      "description": "El dominio, sin barra al final."
    },
    "siteTitle": {
      "type": "string"
    },
    "seo": {
      "type": "object",
      "description": "author, description, keywords: lo que sale en Google."
    },
    "social": {
      "type": "object"
    },
    "colors": {
      "type": "object",
      "description": "Los colores de cada página."
    },
    "ui": {
      "type": "object",
      "description": "Los textos de los botones y las pestañas."
    },
    "home": {
      "type": "object"
    },
    "about": {
      "type": "object"
    },
    "dressme": {
      "type": "object",
      "description": "El juego de vestir: categorías, flechas, música…"
    },
    "sketchbook": {
      "type": "object",
      "required": [
        "imgCount",
        "basePath"
      ],
      "properties": {
        "imgCount": {
          "type": "number",
          "minimum": 0,
          "description": "Cuántas imágenes: 1, 2, 3… en su carpeta, sin comillas."
        },
        "basePath": {
          "type": "string"
        },
        "prefijo": {
          "type": "string"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "La galería del sketchbook."
    },
    "freestuff": {
      "type": "object",
      "required": [
        "imgCount",
        "basePath"
      ],
      "properties": {
        "imgCount": {
          "type": "number",
          "minimum": 0,
          "description": "Cuántas imágenes: 1, 2, 3… en su carpeta, sin comillas."
        },
        "basePath": {
          "type": "string"
        },
        "prefijo": {
          "type": "string"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "La galería de free stuff."
    },
    "bazar": {
      "type": "object",
      "required": [
        "imgCount",
        "basePath"
      ],
      "properties": {
        "imgCount": {
          "type": "number",
          "minimum": 0,
          "description": "Cuántas imágenes: 1, 2, 3… en su carpeta, sin comillas."
        },
        "basePath": {
          "type": "string"
        },
        "prefijo": {
          "type": "string"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "La galería del bazar."
    },
    "animations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cómo se ven las animaciones en la home.",
      "properties": {
        "opacidadTitulo": {
          "type": "number"
        },
        "opacidadMotivo": {
          "type": "number"
        }
      }
    },
    "lists": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "animations": {
          "type": "object",
          "required": [
            "projects"
          ],
          "additionalProperties": false,
          "properties": {
            "projects": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "description": "El nombre de la carpeta en projects/: minúsculas, números y guiones. Sale en la dirección: /animacion/<nombre>/"
              },
              "description": "Las animaciones, en el orden de la home: los nombres de las carpetas de projects/."
            }
          }
        }
      }
    }
  }
}
